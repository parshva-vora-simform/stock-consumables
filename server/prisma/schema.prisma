// Stock & Consumables — data model
//
// The most important thing in this file is something that ISN'T here:
// `Item` has no quantity column. Current stock is arrived at only through
// movements (FR-1.3). If you are ever tempted to add one, read the four stock
// rules in CLAUDE.md first.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UnitOfMeasure {
  EACH
  KG
  LITRE
  METRE
  BOX
  PACK
}

enum Direction {
  IN
  OUT
}

enum MovementType {
  /// An ordinary stock in or stock out.
  NORMAL
  /// Negates an earlier movement. The only way to correct a mistake (FR-6.1).
  REVERSAL
  /// Generated by a physical count, to close the gap between counted and system.
  STOCK_TAKE_ADJUSTMENT
}

enum UserRole {
  HANDLER
  MANAGER
}

enum AccessChangeAction {
  GRANTED
  REVOKED
}

enum AttemptOutcome {
  ACCEPTED
  REJECTED_INSUFFICIENT_STOCK
  REJECTED_VALIDATION
  REJECTED_FORBIDDEN
  REJECTED_NOT_FOUND
  REJECTED_CONFLICT
}

// ---------------------------------------------------------------------------
// People and places
// ---------------------------------------------------------------------------

model User {
  id                String   @id @default(uuid()) @db.Uuid
  email             String   @unique
  passwordHash      String   @map("password_hash")
  name              String
  role              UserRole @default(HANDLER)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  /// When the password last changed. Informational — shown in the UI and kept
  /// for the audit trail. Authentication does NOT decide on this field.
  passwordChangedAt DateTime @default(now()) @map("password_changed_at")

  /// Bumped every time the password changes. A token carries the epoch it was
  /// minted under, and is refused once the two disagree.
  ///
  /// This is a counter rather than a timestamp comparison on purpose. A JWT's
  /// `iat` is in whole seconds while a timestamp carries milliseconds, so
  /// comparing them is wrong in both directions at once: strict comparison
  /// locks people out of accounts created in the same second, and truncating to
  /// seconds lets a reset that happens within a second of sign-in fail to
  /// invalidate anything. An integer that either matches or does not has no
  /// such window.
  tokenEpoch Int @default(0) @map("token_epoch")

  locationAccess   UserLocationAccess[]
  passwordResets   PasswordResetToken[]
  refreshTokens    RefreshToken[]
  /// Access granted to or revoked from THIS person.
  accessHistory    LocationAccessChange[] @relation("AccessSubject")
  /// Access changes THIS person made to others (managers only).
  accessChanges    LocationAccessChange[] @relation("AccessActor")
  movements        Movement[]
  stockTakes       StockTake[]
  movementAttempts MovementAttempt[]

  @@map("users")
}

model Location {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  userAccess    UserLocationAccess[]
  accessChanges LocationAccessChange[]
  movements     Movement[]
  balances      StockBalance[]
  stockTakes    StockTake[]

  @@map("locations")
}

/// Which locations a handler may act on. A manager bypasses this and sees all
/// locations; a handler's list is folded into the WHERE clause of every query
/// that touches stock, never applied after fetching (AC-2).
model UserLocationAccess {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  grantedAt  DateTime @default(now()) @map("granted_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([userId])
  @@map("user_location_access")
}

// ---------------------------------------------------------------------------
// Items
// ---------------------------------------------------------------------------

model Item {
  id            String        @id @default(uuid()) @db.Uuid
  sku           String        @unique
  name          String        @unique
  unitOfMeasure UnitOfMeasure @map("unit_of_measure")
  /// Low-stock alerts fire at or below this figure (FR-7.1).
  minThreshold  Int           @default(0) @map("min_threshold")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // NO quantity / stock / onHand field. This absence IS the requirement.

  movements  Movement[]
  balances   StockBalance[]
  stockTakes StockTake[]

  @@index([isActive, name])
  @@map("items")
}

// ---------------------------------------------------------------------------
// The ledger — append-only
// ---------------------------------------------------------------------------

/// One immutable stock event. Rows are never updated or deleted: a database
/// trigger (migration 0002) raises an exception on UPDATE or DELETE, so even a
/// stray `prisma.movement.update()` or a hand-typed SQL statement fails loudly.
model Movement {
  id String @id @default(uuid()) @db.Uuid

  itemId     String @map("item_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid

  direction      Direction
  /// Always positive — the magnitude. Direction carries the sign's meaning.
  quantity       Int
  /// +quantity for IN, -quantity for OUT. Persisted so a balance is a plain
  /// SUM() with no CASE expression, which keeps the index-only scan available.
  signedQuantity Int       @map("signed_quantity")

  movementType MovementType @default(NORMAL) @map("movement_type")

  recordedByUserId String   @map("recorded_by_user_id") @db.Uuid
  /// When the stock physically moved. May predate createdAt (back-dated entry).
  occurredAt       DateTime @default(now()) @map("occurred_at")
  /// When the row was written. Never back-dated — this is the audit timestamp.
  createdAt        DateTime @default(now()) @map("created_at")

  /// e.g. "PO #4521"
  reference String?
  /// e.g. "issued to site A"
  note      String?

  /// Set on a REVERSAL, pointing at the movement it undoes. Unique, so a
  /// movement can be reversed at most once (FR-6.2).
  reversesMovementId String? @unique @map("reverses_movement_id") @db.Uuid

  /// Shared by the OUT and IN legs of a location-to-location move (FR-5.3).
  transferGroupId String? @map("transfer_group_id") @db.Uuid

  stockTakeId String? @map("stock_take_id") @db.Uuid

  /// Client-supplied. Makes a retried or double-clicked submit safe (FR-2.4):
  /// the unique index below turns a duplicate into a conflict the API converts
  /// into "here is the movement you already recorded".
  idempotencyKey String? @map("idempotency_key")

  item       Item       @relation(fields: [itemId], references: [id])
  location   Location   @relation(fields: [locationId], references: [id])
  recordedBy User       @relation(fields: [recordedByUserId], references: [id])
  reverses   Movement?  @relation("MovementReversal", fields: [reversesMovementId], references: [id])
  reversedBy Movement?  @relation("MovementReversal")
  stockTake  StockTake? @relation("StockTakeAdjustment", fields: [stockTakeId], references: [id])

  @@unique([recordedByUserId, idempotencyKey])
  /// Serves the default history page: newest first for one item (FR-8.3).
  @@index([itemId, occurredAt(sort: Desc), id(sort: Desc)])
  /// Serves history filtered to one location.
  @@index([itemId, locationId, occurredAt(sort: Desc), id(sort: Desc)])
  /// Serves the derived-sum reconciliation as an index-only scan.
  @@index([itemId, locationId])
  @@index([transferGroupId])
  @@map("movements")
}

// ---------------------------------------------------------------------------
// Derived balance
// ---------------------------------------------------------------------------

/// The running total for one item at one location (FRD §5.1).
///
/// This is a CACHE, not the source of truth — the ledger is. It is safe to
/// read from because:
///   1. it is written in the same transaction as the movement that changes it,
///   2. it is only ever updated relatively (quantity = quantity + n), never set,
///   3. a CHECK (quantity >= 0) in migration 0002 makes a negative impossible,
///   4. `pnpm reconcile` continuously asserts it still equals SUM(ledger).
///
/// Only server/src/modules/movements/repository.ts may write to this table.
model StockBalance {
  itemId     String   @map("item_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  quantity   Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at")

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([itemId, locationId])
  /// Serves the low-stock scan per location (FR-7.2).
  @@index([locationId, quantity])
  @@map("stock_balances")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Every attempt to record a movement — accepted AND rejected (FR-9.1).
/// Written outside the business transaction, so a rollback cannot erase the
/// evidence of its own failure.
model MovementAttempt {
  id                  String         @id @default(uuid()) @db.Uuid
  userId              String         @map("user_id") @db.Uuid
  attemptedAt         DateTime       @default(now()) @map("attempted_at")
  itemId              String?        @map("item_id") @db.Uuid
  locationId          String?        @map("location_id") @db.Uuid
  direction           Direction?
  quantity            Int?
  outcome             AttemptOutcome
  /// Why it was refused, in words. Null on ACCEPTED.
  failureDetail       String?        @map("failure_detail")
  resultingMovementId String?        @map("resulting_movement_id") @db.Uuid
  /// Ties this row to the structured log line for the same request (FR-9.4).
  requestId           String         @map("request_id")
  ipAddress           String?        @map("ip_address")

  user User @relation(fields: [userId], references: [id])

  // itemId, locationId and resultingMovementId are stored WITHOUT foreign keys
  // (migration 0004). An audit row records what was ATTEMPTED — including a
  // movement against an item id that does not exist, which is one of the more
  // interesting things to keep a record of. A constraint here would make that
  // attempt unrecordable and leave a hole in exactly the trail FR-9.2 asks for.

  @@index([userId, attemptedAt(sort: Desc), id(sort: Desc)])
  @@index([itemId, attemptedAt(sort: Desc), id(sort: Desc)])
  @@index([outcome, attemptedAt(sort: Desc)])
  @@map("movement_attempts")
}

// ---------------------------------------------------------------------------
// Stock take
// ---------------------------------------------------------------------------

/// A physical count. Reconciled by APPENDING a correcting movement, never by
/// writing the counted figure to StockBalance (FR-10.3). This model is the
/// acid test of "no path sets a quantity" — if it can be done here, it can be
/// done anywhere.
model StockTake {
  id              String   @id @default(uuid()) @db.Uuid
  itemId          String   @map("item_id") @db.Uuid
  locationId      String   @map("location_id") @db.Uuid
  /// What the shelf actually held.
  countedQuantity Int      @map("counted_quantity")
  /// What the ledger said at the moment of counting, kept for the audit record.
  systemQuantity  Int      @map("system_quantity")
  countedByUserId String   @map("counted_by_user_id") @db.Uuid
  reason          String
  createdAt       DateTime @default(now()) @map("created_at")

  item        Item       @relation(fields: [itemId], references: [id])
  location    Location   @relation(fields: [locationId], references: [id])
  countedBy   User       @relation(fields: [countedByUserId], references: [id])
  /// The generated adjustment (absent when counted == system, i.e. no drift).
  adjustments Movement[] @relation("StockTakeAdjustment")

  @@index([itemId, createdAt(sort: Desc)])
  @@map("stock_takes")
}

// ---------------------------------------------------------------------------
// Access history
// ---------------------------------------------------------------------------

/// Who could reach which location, and since when.
///
/// Location access decides who may move stock where, so a change to it is a
/// security-relevant event and is recorded like one: append-only, attributed,
/// timestamped. Without this, "why was this person able to issue stock at
/// SITE-1 last March?" is unanswerable — the grant table only ever shows the
/// present.
///
/// Revoking access never touches past movements. Those are immutable and stay
/// attributed to the person who recorded them; losing access going forward is
/// not the same as never having been there.
model LocationAccessChange {
  id              String             @id @default(uuid()) @db.Uuid
  /// The employee whose access changed.
  userId          String             @map("user_id") @db.Uuid
  locationId      String             @map("location_id") @db.Uuid
  action          AccessChangeAction
  /// The manager who made the change.
  changedByUserId String             @map("changed_by_user_id") @db.Uuid
  changedAt       DateTime           @default(now()) @map("changed_at")
  reason          String?
  requestId       String             @map("request_id")

  user      User     @relation("AccessSubject", fields: [userId], references: [id])
  changedBy User     @relation("AccessActor", fields: [changedByUserId], references: [id])
  location  Location @relation(fields: [locationId], references: [id])

  @@index([userId, changedAt(sort: Desc)])
  @@index([locationId, changedAt(sort: Desc)])
  @@map("location_access_changes")
}

/// A single-use, short-lived password reset token.
///
/// Only the SHA-256 hash is stored. A leaked database therefore yields no
/// usable reset links — the same reasoning that applies to passwords applies to
/// anything that can stand in for one.
model PasswordResetToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// SHA-256 of the token. The token itself is never persisted.
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  /// Set the moment it is redeemed, so a token works exactly once.
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  /// Who asked, for the audit trail and for throttling.
  requestIp      String?   @map("request_ip")
  /// Set when a manager generated the link on someone else's behalf.
  issuedByUserId String?   @map("issued_by_user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// One issued refresh token.
///
/// Refresh tokens rotate: every use spends the presented token and issues a
/// replacement. That turns theft into something detectable — if a spent token
/// is presented again, either the attacker is using the copy they stole or the
/// legitimate client is replaying, and neither is a state in which the session
/// should continue. The whole family is revoked and the person signs in again.
///
/// Only the SHA-256 hash is stored, for the same reason password reset tokens
/// store only a hash: a leaked database must not yield usable credentials.
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// SHA-256 of the token body. The token itself is never persisted.
  tokenHash String   @unique @map("token_hash")
  /// Every token descended from one sign-in shares a family id, so detecting
  /// reuse anywhere in the chain can revoke the entire lineage at once.
  familyId  String   @map("family_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  /// Set when this token was exchanged. A second exchange is reuse.
  usedAt    DateTime? @map("used_at")
  /// Set when the family was revoked, by reuse detection or by signing out.
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
