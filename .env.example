# ---------------------------------------------------------------------------
# Copy to .env before `docker compose up`. Every variable here is required;
# server/src/config/env.ts validates them at boot and exits with a readable
# message if any is missing or malformed (NFR-1).
# ---------------------------------------------------------------------------

# --- Postgres (consumed by the postgres service and by DATABASE_URL below) ---
POSTGRES_USER=stock
POSTGRES_PASSWORD=stock_dev_password
POSTGRES_DB=stock_consumables
POSTGRES_PORT=5432

# Used by HOST-side tooling only: the Prisma CLI, `pnpm dev`, the test suite.
# Containers do not read this — docker compose builds its own URL from the
# POSTGRES_* parts above, using the service name as the host. So this can stay
# pointed at localhost and both work.
DATABASE_URL=postgresql://stock:stock_dev_password@localhost:5432/stock_consumables?schema=public

# --- API ---
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173

# --- Auth ---
# Any non-empty string of 32+ chars in dev. Generate for real use:
#   openssl rand -base64 48
JWT_SECRET=dev_only_secret_change_me_min_32_characters_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Tests ---
# The suite truncates every table between files, so it refuses to run against a
# database whose name does not contain "test". Create it once with:
#   docker compose exec postgres createdb -U $POSTGRES_USER stock_test
TEST_DATABASE_URL=postgresql://stock:stock_dev_password@localhost:5432/stock_test?schema=public

# --- Client (Vite; must stay VITE_-prefixed to reach the browser) ---
VITE_API_URL=http://localhost:4000/api/v1

# Enables the /dev/race demo page (UI-9). Never enable outside development.
VITE_ENABLE_RACE_DEMO=true
